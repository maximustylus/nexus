rules_version = '2';

// =============================================================================
// NEXUS AURA — FIRESTORE SECURITY RULES
// =============================================================================
// STATUS: WIRED · multi-team rewrite · `firebase.json` deploys `firestore:rules`
//         and `.github/workflows/deploy.yml` runs `--only functions,firestore:rules`.
//
// -----------------------------------------------------------------------------
// WHAT THIS FILE STOPPED BEING
// -----------------------------------------------------------------------------
//
// Until this rewrite, this file contained A THIRD COPY OF THE TEAM. `directory()`
// held ten email addresses and their display names; `directoryNames()` held the same
// ten names again as a list, because the rules language has no `Map.values()`; and
// `adminEmails()` held two more. Its own header called that "a KNOWN, ACCEPTED
// defect": onboarding one clinician meant editing `src/utils/index.js`, editing this
// file, and redeploying the rules.
//
// All three are gone. A rule now asks a question of the DATABASE:
//
//     exists(/databases/$(database)/documents/teams/$(teamId)/members/$(uid))
//
// Onboarding a clinician is a lead adding a member document. Zero rule edits, zero
// rules deploys. That is the difference between a file that serves one department
// and one that serves twenty-eight.
//
// -----------------------------------------------------------------------------
// THE ONE PROPERTY THIS FILE EXISTS TO GUARANTEE
// -----------------------------------------------------------------------------
//
// ⚠️ A MEMBER OF TEAM A GETS NOTHING FROM TEAM B. Not the roster, not the swaps, not
//    the wellbeing records, not the member list, not even the team's name. Every
//    team-scoped rule below begins with `isMember(teamId)`, where `teamId` is the
//    path segment being read — so the question is always "are you in THIS team",
//    never "are you in A team".
//
//    `scripts/firestore-rules-verify.mjs` asserts this for every collection. Those
//    are the most important cases in the suite: everything else here protects a
//    department from mistakes, and this protects one department from another.
//
// -----------------------------------------------------------------------------
// IDENTITY IS `uid`, NEVER A DISPLAY NAME
// -----------------------------------------------------------------------------
//
// The previous version of this file carried the diagnosis in its own comments:
// *"The only durable fix is to stop keying documents by display name. That is an
// application change."* That change has now happened. `myName()` and `myId()` are
// deleted along with the directory they read from, and nothing below compares a
// person to a string a person can edit.
//
// -----------------------------------------------------------------------------
// WHAT `get()` AND `exists()` COST
// -----------------------------------------------------------------------------
//
// Each is a billed document read and they are capped — 10 per single-document
// request, 20 per query. `isMember()` spends one; `isLead()` spends two. Nothing
// below nests them, so no rule approaches the cap. Identical lookups inside one
// evaluation are served from a per-request cache, but no rule here relies on that.
//
// The trade is deliberate: a read per request buys a membership model that a lead
// maintains without a deploy. The alternative — custom claims on the ID token — is
// free to evaluate and up to an hour stale, which for "remove this person from the
// team" is the wrong kind of wrong.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================================
    // SECTION 1 — IDENTITY, AS DATA
    // ==========================================================================

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function memberRef(teamId) {
      return /databases/$(database)/documents/teams/$(teamId)/members/$(uid());
    }

    /**
     * THE GATE ON EVERYTHING TEAM-SCOPED. `teamId` is always the path segment being
     * read or written, so this asks "are you in THIS team" — the question that makes
     * cross-team isolation true by construction rather than by remembering to check.
     */
    function isMember(teamId) {
      return isSignedIn() && exists(memberRef(teamId));
    }

    /**
     * May configure the roster, generate it, edit the member list, and publish
     * reports. `role` lives on the membership document, so the same person can lead
     * one department and be staff in another — which the previous `adminEmails()`
     * list could not express at all.
     *
     * ⚠️ NOT the same question as `rostered`. That field says whether somebody holds
     *    clinical duties and is read by the APP to build the staff pool; it grants
     *    nothing and is deliberately not consulted here. A team's roster master is a
     *    lead who is not rostered; its service lead is a lead who is.
     */
    function isLead(teamId) {
      return isMember(teamId) && get(memberRef(teamId)).data.role == 'lead';
    }

    /** The caller's own document, whatever the collection. */
    function isSelf(userId) {
      return isSignedIn() && userId == uid();
    }

    // Lower-cased email of the caller, or '' when there is no usable identity.
    // Guarded three ways because `request.auth.token.email` is absent for some
    // providers and null-dereferencing in rules is an evaluation ERROR, which
    // Firestore treats as DENY — a silent lockout rather than a clean false.
    //
    // Used in exactly one place now (pinning a lead request to its own account);
    // nothing else in this file routes by email.
    function callerEmail() {
      return request.auth != null
             && request.auth.token != null
             && request.auth.token.email != null
             ? request.auth.token.email.lower()
             : '';
    }

    // DELIBERATELY NOT REQUIRED ON READS: `request.auth.token.email_verified`.
    //
    // An ID token is cached for up to an hour, so a clinician who verifies their
    // address mid-session carries `email_verified: false` until it refreshes and
    // would be denied everything for that hour with no explanation. The check lives
    // where it can be enforced without that failure mode: `WelcomeScreen` refuses to
    // complete a login for an unverified account, and `approveLeadRequest` reads
    // `getUser(uid).emailVerified` on the Admin SDK before creating any team.

    // ── Shared shape helpers ────────────────────────────────────────────────
    // A roster date key, e.g. "2026-02-02". Both engines emit exactly this via
    // local getters (`auraEngine.js` toDateKey, `rosterEngineV2.js` toLocalDateKey).
    function isDateKey(k) {
      return k.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // True when this write changes nothing outside the keys the document already
    // had — stops a non-lead INVENTING a top-level key on a shared document while
    // still letting them modify an existing one.
    function addsNoNewKeys() {
      return request.resource.data.keys().hasOnly(resource.data.keys());
    }

    // ⚠️ `diff().affectedKeys()` is keys whose VALUE CHANGED, not keys written. A
    //    write that sets a field to what it already held affects nothing. A test
    //    asserting "cannot change two days in one write" passed spuriously once
    //    because it wrote `[]` over an already-`[]` day; any case built on this must
    //    write genuinely different values.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }


    // ==========================================================================
    // SECTION 2 — THE TEAM, AND WHO IS IN IT
    // ==========================================================================
    //
    // ⚠️ NEITHER OF THESE MAY BE CREATED BY A CLIENT. `approveLeadRequest` on the
    //    Admin SDK is the only thing that brings a team and its first membership
    //    into existence, and it bypasses this file by design. A client that could
    //    write its own membership document could grant itself everything below it —
    //    every rule here trusts that document, so it is the one document a client
    //    must never author.

    match /teams/{teamId} {
      allow get: if isMember(teamId);
      // No client lists teams. A member reaches their teams through
      // `users/{uid}.teamIds`, which is the only place that relationship lives.
      allow list: if false;

      // A lead renames the team or corrects its institution; nothing more.
      allow create: if false;                      // Cloud Function only.
      allow update: if isLead(teamId)
                    && changedKeys().hasOnly(['name', 'institution', 'department', 'profession']);
      allow delete: if false;

      // ── The member list ────────────────────────────────────────────────────
      //
      // THIS SUBCOLLECTION IS WHAT REPLACED `TEAM_DIRECTORY`, `directoryNames()`,
      // `adminEmails()` and the five-name exclusion list in `AdminPanel.jsx`. A lead
      // maintaining it is the whole onboarding story.
      match /members/{memberUid} {
        // Everyone in the team can see who else is in it — the roster, the swap
        // picker and the load table are all built from this list.
        allow get, list: if isMember(teamId);

        // ⚠️ A LEAD MAY NOT MINT A MEMBERSHIP FOR AN ARBITRARY uid. `create` is
        //    denied outright: the invitation path is a Cloud Function, which can
        //    check that the uid belongs to a real, verified account on an
        //    allowlisted domain. Rules cannot see any of that. Without this, a lead
        //    could add a uid they do not control and then sign in as it.
        allow create: if false;

        // A lead edits anybody's roster attributes. `role` and `rostered` are
        // included: promoting a colleague to lead, or marking the roster master as
        // carrying no duties, is exactly this screen's job.
        allow update: if isLead(teamId)
                      && changedKeys().hasOnly([
                           'displayName', 'grade', 'fte', 'skills',
                           'unavailable', 'role', 'rostered', 'title'
                         ]);

        // A member maintains their OWN availability and skills without needing a
        // lead — but cannot touch `role` or `rostered`, which would be granting
        // themselves powers or duties.
        allow update: if isSelf(memberUid)
                      && isMember(teamId)
                      && changedKeys().hasOnly(['skills', 'unavailable', 'title']);

        // ⚠️ REMOVING SOMEBODY IS A CLOUD FUNCTION, NOT A DELETE. The membership
        //    document is only half of it: `users/{uid}.teamIds` has to lose the team
        //    in the same breath, or the person keeps a team in their switcher that
        //    they can no longer read and every listener fails permission-denied.
        //    Rules cannot write two documents, so they permit neither.
        allow delete: if false;
      }

      // ── The duty roster, one document per year ─────────────────────────────
      //
      // Was `system_data/roster_2026` — ONE document for the whole installation.
      match /rosters/{year} {
        allow get: if isMember(teamId);
        allow list: if false;

        // (a) GENERATION — leads only. `setDoc(..., { merge: true })` is a create
        //     when the document is absent and an update when it is present, so both
        //     verbs are needed.
        allow create: if isLead(teamId);
        allow update: if isLead(teamId);

        // (b) ONE DAY, IN PLACE, by any member completing a coverage swap.
        //
        //     The verb split is what stops this being a way to create the roster: a
        //     member cannot bring the document into existence, only alter one day of
        //     an existing one. A `resource != null` guard was here once and was
        //     removed as unreachable — Firestore only evaluates `update` when the
        //     document already exists.
        allow update: if isMember(teamId)
                      && changedKeys().size() == 1
                      && addsNoNewKeys();

        allow delete: if false;
      }

      // ── Coverage / shift swaps ─────────────────────────────────────────────
      //
      // ⚠️ ROUTED BY `targetUid`, NOT BY DISPLAY NAME. The read rule's predicate is
      //    exactly the app's query predicate — Firestore evaluates a list rule
      //    against every document the query would return — so changing one without
      //    the other makes the listener silently return nothing, which is
      //    indistinguishable from nobody having asked.
      //
      //    `requestedBy` is still a NAME on the document because the roster mutator
      //    matches it against the roster's own day arrays. It is not used for
      //    authorization anywhere here.
      match /swaps/{swapId} {
        allow read: if isMember(teamId)
                    && (
                         resource.data.get('targetUid', '') == uid()
                         || resource.data.get('requestedUid', '') == uid()
                       );

        // Anyone in the team may ASK a colleague to cover. The shape is pinned so a
        // request cannot arrive pre-approved, and `status` must start PENDING.
        allow create: if isMember(teamId)
                      && request.resource.data.status == 'PENDING'
                      && request.resource.data.targetUid is string
                      && request.resource.data.targetUid != uid()   // not yourself
                      && request.resource.data.originalShiftDate is string
                      && isDateKey(request.resource.data.originalShiftDate)
                      && request.resource.data.swapRole in ['lead', 'coLead']
                      && request.resource.data.timestamp == request.time;

        // ⚠️ ONLY THE PERSON ASKED MAY ANSWER, and only by moving the status. A
        //    member who could update any swap could approve a hand-over nobody
        //    agreed to; one who could edit `originalShiftDate` could redirect an
        //    accepted swap onto a different day after the fact.
        allow update: if isMember(teamId)
                      && resource.data.get('targetUid', '') == uid()
                      && resource.data.status == 'PENDING'
                      && request.resource.data.status in ['APPROVED', 'DENIED']
                      && changedKeys().hasOnly(['status', 'approvedAt', 'deniedAt']);

        allow delete: if false;
      }

      // ── Wellbeing: the most sensitive collection in the project ────────────
      //
      // A longitudinal energy and burnout record per clinician. Owner-or-lead, and
      // NEVER readable by a colleague.
      match /wellbeing/{memberUid} {
        allow get: if isSelf(memberUid) && isMember(teamId);
        // The burnout monitor. A lead sees the team's trends; nobody else lists it.
        allow list: if isLead(teamId);
        allow create, update: if isSelf(memberUid) && isMember(teamId);
        // A wellbeing record is not erasable by the person having a bad month, and
        // not by anybody else either.
        allow delete: if false;
      }

      // The shared bucket an anonymous check-in appends to. WRITE-ONLY: not
      // readable by anyone, including a lead — the point of logging anonymously is
      // that it cannot be attributed, and a reader who can see one entry arriving
      // can attribute it by timing.
      match /wellbeing/_anonymous_logs {
        allow read: if false;
        allow create, update: if isMember(teamId);
        allow delete: if false;
      }

      // ── The pulse board ────────────────────────────────────────────────────
      //
      // A live snapshot everyone in the team can see and add their own row to.
      // ⚠️ The MAP INSIDE is still keyed by display name. Team scoping is what makes
      //    that safe enough to leave: two people called Sarah in different
      //    departments now write to different documents. Two in the same department
      //    would still collide, which the lead fixes by editing a name.
      match /pulse/{period} {
        allow get: if isMember(teamId);
        allow list: if false;
        allow create, update: if isMember(teamId);
        allow delete: if false;
      }

      // ── Clinical load, per person per year ─────────────────────────────────
      match /loads/{memberUid} {
        allow get, list: if isMember(teamId);
        // A lead maintains the whole grid; a clinician may correct their own row.
        allow create, update: if isLead(teamId) || (isSelf(memberUid) && isMember(teamId));
        allow delete: if false;
      }

      // ── Projects and domains, per person per year ──────────────────────────
      //
      // Was `cep_team` for the current year and `archive_{year}` for every other —
      // one shape in two differently-named collections. The year is a document and
      // the people hang beneath it, so 2026 stopped being special.
      match /projects/{year} {
        allow read: if isMember(teamId);
        allow write: if isLead(teamId);

        match /staff/{memberUid} {
          allow get, list: if isMember(teamId);
          allow create, update: if isLead(teamId);
          allow delete: if false;
        }
      }

      // ── Team-wide aggregates a lead maintains ──────────────────────────────
      match /attendance/{year} {
        allow get: if isMember(teamId);
        allow list: if false;
        allow create, update: if isLead(teamId);
        allow delete: if false;
      }

      match /workload/{period} {
        // Nothing reads it today; AURA's DATA_ENTRY writes it. Read stays denied
        // until something actually reads it, rather than pre-granting access to a
        // collection whose consumers are unknown.
        allow read: if false;
        allow create, update: if isLead(teamId);
        allow delete: if false;
      }

      match /reports/{year} {
        // The AI-generated year-end report. Every member may read it; a lead
        // publishes it.
        allow get: if isMember(teamId);
        allow list: if false;
        allow create, update: if isLead(teamId);
        allow delete: if false;
      }

      // ── The team feed ──────────────────────────────────────────────────────
      //
      // Was one global `feed_posts` collection, so a KKH respiratory therapist's
      // post appeared on an SGH physiotherapist's wall.
      match /feed/{postId} {
        allow get, list: if isMember(teamId);
        // Cloud Function only — `processFeedPost` runs the PDPA guard, and a post
        // that bypassed it would defeat the point of having one.
        allow create: if false;
        // Likes and comment counts are the only client-side mutations.
        allow update: if isMember(teamId)
                      && changedKeys().hasOnly(['likes', 'comments']);
        allow delete: if isMember(teamId);

        match /comments/{commentId} {
          allow get, list: if isMember(teamId);
          allow create: if isMember(teamId)
                        && request.resource.data.keys().hasOnly(['author', 'text', 'timestamp'])
                        && request.resource.data.text is string
                        && request.resource.data.text.size() > 0
                        && request.resource.data.text.size() <= 5000
                        && request.resource.data.timestamp == request.time;
          // ⚠️ `author` IS NO LONGER PINNED TO THE CALLER'S NAME, and that is a
          //    deliberate loosening with a reason. The old rule required
          //    `author == myName()` against the hardcoded directory — which meant a
          //    member who renamed themselves in their profile was DENIED their own
          //    comment, silently. The durable fix is an `authorUid` field the rules
          //    can pin to `uid()`; the app does not write one yet, so pinning a
          //    display name would restore the bug rather than the protection.
          //    Tracked, and the cost is bounded: a member can post a comment under
          //    another member's name inside their own team's feed.
          allow update: if false;
          allow delete: if false;
        }
      }

      // ── Notifications ──────────────────────────────────────────────────────
      //
      // Same list-rule mechanics as swaps: the read predicate IS the app's query
      // predicate, so the query stays satisfiable.
      match /notifications/{notificationId} {
        allow read: if isMember(teamId)
                    && resource.data.get('recipientUid', '') == uid();
        // Created by nothing today. If a Cloud Function is built for it, it will use
        // the Admin SDK and bypass this rule anyway.
        allow create: if false;
        allow update: if isMember(teamId)
                      && resource.data.get('recipientUid', '') == uid()
                      && changedKeys().hasOnly(['read']);
        allow delete: if false;
      }
    }


    // ==========================================================================
    // SECTION 3 — THE PERSON, WHICH IS NOT A MEMBERSHIP
    // ==========================================================================
    //
    // One human has one profile and may belong to several teams. Scoping this per
    // team would mean a clinician editing their own name twice.

    match /users/{userId} {
      allow get: if isSelf(userId);
      allow list: if false;

      // ⚠️ `teamIds` IS THE ONE FIELD A USER MAY NOT TOUCH. It is the whole
      //    membership graph as far as the client is concerned — `TeamContext` reads
      //    it to decide which teams exist for this person, and `canActOn` is derived
      //    from it. A user who could append to it would hand themselves a team in
      //    the switcher; the per-team rules would still deny the reads, but they
      //    would be denials rather than a design. Only the Admin SDK writes it.
      allow create, update: if isSelf(userId)
                            && !changedKeys().hasAny(['teamIds']);
      allow delete: if false;
    }


    // ==========================================================================
    // SECTION 4 — ONBOARDING: THE ALLOWLIST AND THE LEAD DECLARATION
    // ==========================================================================
    //
    // The two paths by which somebody who is not already in a team arrives at NEXUS
    // at all. Deliberately the least powerful in the file: neither can create a
    // team, a membership, or any access to clinical data.

    // ── config/domains — READ BY AN ANONYMOUS VISITOR, ON PURPOSE ─────────────
    // `useDomainAllowlist.js` reads this BEFORE sign-in, so the registration form
    // can say "we are not open to nuh.edu.sg yet" instead of failing opaquely. A
    // list of hospital domains is not a secret; hiding it would only mean nobody
    // could be told why they were refused.
    //
    // ⚠️ `get` IS PINNED TO ONE DOCUMENT ID AND `list` IS DENIED. Both matter.
    //    `config/superAdmins` names the people who can approve teams — a reader who
    //    could list `config`, or `get` any docId, would harvest exactly the accounts
    //    worth phishing. `allow get: if true` on the collection is the obvious,
    //    wrong, one-word version of this rule.
    match /config/{docId} {
      allow get: if docId == 'domains';
      allow list: if false;
      allow write: if false;
    }

    // ── lead_requests/{uid} — A CLAIM, NOT A GRANT ───────────────────────────
    //
    // WHY VERIFICATION IS NOT REQUIRED HERE, which looks like a hole and is not:
    // this document is created seconds after `createUserWithEmailAndPassword`,
    // before the verification email has arrived. Requiring `email_verified` would
    // make the declaration impossible to write at the only moment the flow can write
    // it. The check lives where it can be enforced — `approveLeadRequest` reads
    // `getUser(uid).emailVerified` on the Admin SDK and refuses to approve an
    // unverified account. A pending request grants nothing and reads nothing.
    //
    // THE DOCUMENT ID IS THE UID, which is the whole authorization model of this
    // block: a caller can only write their own request, cannot enumerate anyone
    // else's, and cannot forge one on a colleague's behalf.
    //
    // ⚠️ KNOWN GAP, ACCEPTED: a DECLINED request cannot be re-made — `create` does
    //    not apply to an existing document and `update` is denied. The declined
    //    screen tells the person to ask their department lead instead, which is the
    //    better route anyway.
    //
    // `list` is denied even for administrators: the super-admin screen gets pending
    // requests from a callable function, which is what keeps the list of
    // super-admins out of this file.
    match /lead_requests/{requestUid} {
      allow get: if isSelf(requestUid);
      allow list: if false;
      allow create: if isSelf(requestUid)
                    && request.resource.data.keys().hasOnly([
                         'uid', 'email', 'displayName', 'role', 'institution',
                         'department', 'profession', 'proposedTeamId', 'status',
                         'requestedAt'
                       ])
                    && request.resource.data.uid == uid()
                    && request.resource.data.email == callerEmail()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.role in ['lead', 'supervisor', 'administrator']
                    && request.resource.data.institution is string
                    && request.resource.data.institution.size() > 0
                    && request.resource.data.institution.size() <= 120
                    && request.resource.data.department is string
                    && request.resource.data.department.size() > 0
                    && request.resource.data.department.size() <= 120
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 120
                    && request.resource.data.profession is string
                    && request.resource.data.profession.size() <= 120
                    && request.resource.data.proposedTeamId is string
                    && request.resource.data.proposedTeamId.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
      allow update: if false;           // approval is Admin SDK only.
      allow delete: if false;
    }


    // ==========================================================================
    // SECTION 5 — PUBLIC WRITE-ONLY SINKS
    // ==========================================================================
    //
    // Neither of these is team-scoped, and neither can be: both are written by
    // people with no account at all.

    // ── Beta feedback ────────────────────────────────────────────────────────
    // `FeedbackWidget.jsx` addDoc; never read by any client.
    //
    // ⚠️ ANONYMOUS CREATE IS DELIBERATE, AND IT IS A DECISION, NOT AN OVERSIGHT.
    //    The widget renders in the unauthenticated sandbox. Requiring membership —
    //    as an earlier draft did — means the only feedback anyone can file is from
    //    people who already have accounts, and every visiting department loses the
    //    route entirely. The respiratory and audiology demos of August 2026 both ran
    //    in that sandbox; feedback from a visitor is the point of the widget.
    //
    //    So the gate is the SHAPE, not the identity. It is NOT rate-limited — rules
    //    cannot do that — so this remains an open write endpoint against the billing
    //    account, and the durable answer is a Cloud Function with App Check.
    //    Accepted knowingly rather than discovered later.
    match /beta_feedback/{feedbackId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly([
                         'type', 'message', 'reportedBy', 'environment',
                         'timestamp', 'userAgent'
                       ])
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 10000
                    && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    // ── AURA's audit sink ────────────────────────────────────────────────────
    //
    // ⚠️ THIS BLOCK WAS DROPPED FROM THE v2 REWRITE AND THE CLIENT STILL WRITES TO
    //    IT. The rewrite's header called `smart_database` "left global and unruled
    //    on purpose", which describes the INTENT correctly and produced the wrong
    //    file: Firestore denies by default, so "unruled" is "denied", and the
    //    shipped bundle writes here from the browser twice —
    //    `AuraPulseBot.jsx:633` (DOCX export) and `:672` (save to Smart Database).
    //
    //    The currently deployed rules grant that create. Publishing the rewrite
    //    without this block would have taken it away, and the failure is worse than
    //    a broken button: both call sites catch the denial and tell the user
    //    "Please check your connection", so every clinician would be told their
    //    network is at fault while the export silently never lands.
    //
    //    Restored from `git show origin/main:firestore.rules`, with two changes
    //    forced by the new model: `isMember()` took no argument under the old
    //    single-team rules and now needs one, and there is no team id in this path —
    //    so the gate is `isSignedIn()` plus the shape. That is not a loosening in
    //    any meaningful sense: the collection is write-only to every client, is
    //    never read back by the app, and the old `myName()` check compared against a
    //    display name the person could edit anyway.
    //
    // Create-only means a `Date.now()` COLLISION — two documents minted in the same
    // millisecond — is denied rather than silently overwriting the earlier one. For
    // an audit sink that is the behaviour you want, and it is why `update` is not
    // granted.
    match /smart_database/{docId} {
      allow read: if false;
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly([
                         'timestamp', 'displayDate', 'author', 'role',
                         'content', 'type', 'isDemo', 'silentlyLogged'
                       ])
                    && request.resource.data.content is string
                    && request.resource.data.content.size() <= 100000;
      allow update, delete: if false;
    }

    // ── Community screening telemetry ────────────────────────────────────────
    // Written by members of the public through the portal, with no account.
    // `recordTelemetry` swallows its errors, so a rule that denied the WRITE would
    // break the pathway silently — which is exactly what an earlier draft did by
    // requiring membership.
    //
    // ⚠️ READ IS DENIED TO EVERYBODY, AND THIS CORRECTS AN EARLIER MISTAKE OF MINE.
    //
    //    A previous version of this block granted `read: if isSignedIn()` and
    //    justified it as "the data is postal-sector-level and carries no
    //    identifiers". Both halves of that were wrong.
    //
    //    WHAT IS ACTUALLY STORED, enumerated from the two call sites
    //    (`ConventionalForm.jsx` handleSubmit, `AuraChat.jsx` concludeTriage) plus
    //    `telemetry.js`: postal sector, age band, gender, RACE, housing type, income
    //    adequacy, food insecurity, a psychological-distress flag, a chronic-condition
    //    flag, a chest-pain-on-exertion flag — and `navigator.userAgent`.
    //
    //    Sector + age band + gender + race + housing type is a textbook quasi-identifier
    //    set, and a full user-agent string is a fingerprinting vector. That is health
    //    data about identifiable members of the public, not aggregate statistics.
    //
    //    AND NOTHING READS IT. Grepping `community_assessments` across `src/` and
    //    `functions/` returns exactly one hit: the `addDoc` that writes it. The
    //    "analysis screen" the old comment cited does not exist — I asserted a
    //    consumer without checking for one, and then widened a rule to serve it.
    //
    //    So this is a write-only sink like `beta_feedback`. Analysis happens in the
    //    console or through the Admin SDK, both of which bypass rules entirely, and
    //    neither of which needs a client grant.
    match /community_assessments/{assessmentId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasAll(['createdAt', 'postalSector'])
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.postalSector is string
                    && request.resource.data.postalSector.size() <= 4
                    && request.resource.data.keys().size() <= 20;
      allow update, delete: if false;
    }


    // ==========================================================================
    // SECTION 6 — PATHS THE CLIENT MUST NOT TOUCH AT ALL
    // ==========================================================================
    //
    // Not listed as blocks, because the absence of a rule IS the deny. Recorded so a
    // future reader knows the omission was deliberate:
    //
    //   `resources/{resourceId}`
    //       The national resource registry. Seeded by `scripts/firestore_seed.cjs`
    //       and read only by `publicTriageChat`, both on the Admin SDK. No client
    //       code touches it, so it gets no client permission.
    //
    //   `smart_database/{id}`
    //       AURA's append-only audit sink. Left global and unruled on purpose; it is
    //       never read back and its documents carry their own author.
    //
    //   `system_data/*`, `shift_swaps`, `wellbeing_history`, `staff_loads`,
    //   `cep_team`, `feed_posts`, `notifications`, `monthly_workload`, `archive_*`
    //       THE PRE-MIGRATION COLLECTIONS. Every one of them now has a team-scoped
    //       successor above, and the client no longer composes a path to any of
    //       them. They are given NO rule deliberately — the migration COPIES rather
    //       than moves, so the old documents still exist and must not be reachable
    //       by the new bundle. Their continued existence is the rollback: restore
    //       the previous rules from console history, redeploy the previous bundle,
    //       and the old app reads its own data unharmed.
    //
    //   `demo_*` — e.g. `demo_staff_loads`
    //       The sandbox used to write real documents to a parallel collection. It
    //       no longer writes at all: a sandbox visitor has no team, so there is no
    //       path to compose. Deliberate.
    //
    //   Anything else the language model invents
    //       AURA's DATA_ENTRY once built a collection name from Gemini's output.
    //       The app now allowlists the two it may target and resolves the person
    //       through the member list — but because this file enumerates paths and
    //       Firestore denies by default, an invented name would still write NOTHING.
    //       That remains the single largest security property here, and it comes
    //       free from default-deny.
    //
    // The block below is DOCUMENTATION, not enforcement. Firestore already denies
    // everything unmatched; a rule evaluating to `false` cannot override an `allow`
    // elsewhere. It is here so "is there a catch-all?" has a visible answer.
    match /{unmatched=**} {
      allow read, write: if false;
    }
  }
}
